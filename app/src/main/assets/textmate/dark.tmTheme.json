{
  "name": "GS Dark",
  "settings": [
    {
      "settings": {
        "background": "#1E1E2E",
        "foreground": "#A9B7C6",
        "caret": "#D4AF37",
        "lineHighlight": "#252540",
        "selection": "#4DD4AF37"
      }
    },
    {
      "name": "Comment",
      "scope": "comment",
      "settings": { "foreground": "#808080", "fontStyle": "italic" }
    },
    {
      "name": "String",
      "scope": "string",
      "settings": { "foreground": "#6A8759" }
    },
    {
      "name": "Number",
      "scope": "constant.numeric",
      "settings": { "foreground": "#6897BB" }
    },
    {
      "name": "Keyword",
      "scope": "keyword",
      "settings": { "foreground": "#CC7832", "fontStyle": "bold" }
    },
    {
      "name": "Function",
      "scope": "support.function",
      "settings": { "foreground": "#FFC66D" }
    },
    {
      "name": "Preprocessor",
      "scope": "keyword.preprocessor",
      "settings": { "foreground": "#9876AA" }
    },
    {
      "name": "Operator",
      "scope": "punctuation",
      "settings": { "foreground": "#CCCCCC" }
    },
    {
      "name": "Type",
      "scope": "entity.name.type",
      "settings": { "foreground": "#CC7832" }
    }
  ]
}
