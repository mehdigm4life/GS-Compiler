public OnGameModeInit()
{
	for(new i; i < MAX_VEHICLES; i++) for(new x; x < OILEXPO_LIMIT; x++) OilExpoObjects[i][x] = -1;
	//virtidos radio
	for(new i; i < MAX_FREQUENCY; i++)
    {
        Frequency[i] = SvCreateGStream(0xffff0000, "Radio");
    }

	UpdatePlayerCount();


	//casino
    Create3DTextLabel("[Mafia Casino Stash]\n "GREY" ((Use {FFFF00}/cstash "GREY" bach t3ref ach dir))", COLOR_RED, 1357.937866, -1361.118164, 699.791931, 20.0, 0);

	//spin
	Create3DTextLabel("[Mafia Casino]\n "GREY" ((Use {FFFF00}/spin "GREY" bach t9mmer))", COLOR_RED, 1351.94, -1348.52, 699.37, 20.0, 0);

	//dicebet
	Create3DTextLabel("[Mafia Casino Stash]\n "GREY" ((Use {FFFF00}/dicebet "GREY" bach t9mmer nta w sa7bk))", COLOR_RED, 1372.03, -1359.84, 699.88, 20.0, 0);

	//mdc pos
