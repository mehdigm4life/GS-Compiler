					SendProximityMessage(playerid, 20.0, SERVER_COLOR, "**{C2A2DA} %s has paid a bill for his reviving in.", GetRPName(playerid));
	           	}
	 			else if(listitem == 1) // INSURANCE
				{
					if(PlayerInfo[playerid][pCash] < 5000)
					{
					    return SCM(playerid, COLOR_SYNTAX, "You can't afford insurance.");
					}

					switch(GetPlayerVirtualWorld(playerid))
					{
					    case HOSPITAL_COUNTY:
