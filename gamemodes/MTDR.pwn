}
CMD:hatdjaj(playerid, params[])
{
    if(KerjaAyam[playerid] == 0) return SendClientMessage(playerid, COLOR_RED, "[ERROR] Sir Kod Skin b3da");
    if(TakenAyam[playerid] == 1) return SendClientMessage(playerid, COLOR_RED, "[ERROR] Wa Sir Kod Kdma");
	{
	if(IsPlayerInRangeOfPoint(playerid, 5.0, 730.225524, -462.672058, 16.335937))
    {
        if(PutAyam[playerid] != 5)
        {
        TakenAyam[playerid] = 0;
        RemovePlayerAttachedObject(playerid, 8);
        TogglePlayerControllable(playerid, 0);
        GameTextForPlayer(playerid, "~w~sbr chiwya", 5000, 0);
        SetTimerEx("10sec", 10000, false, "d", playerid);
        ApplyAnimation(playerid,"INT_HOUSE","wash_up",4.0, 1, 0, 0, 0, 0,1);
        SendClientMessage(playerid, COLOR_RED, "Sir Jma3 Ou Hat 3awtani tatjm3 5/5");
        }
        else if(PutAyam[playerid] == 5)
        {
        PutAyam[playerid] = 0;
        TakenAyam[playerid] = 0;
        RemovePlayerAttachedObject(playerid, 8);
        TogglePlayerControllable(playerid, 0);
        GameTextForPlayer(playerid, "~w~sbr chiwya", 5000, 0);
        SetTimerEx("10sec", 10000, false, "d", playerid);
        ApplyAnimation(playerid,"INT_HOUSE","wash_up",4.0, 1, 0, 0, 0, 0,1);
        SendClientMessage(playerid, COLOR_RED, "3la Slamtk 5/5");
        }
    }
    }
    return 1;
}


