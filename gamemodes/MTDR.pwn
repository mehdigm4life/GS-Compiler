CMD:decibit(playerid, params[])
{
    new targetid, amount;

	if(!IsPlayerInRangeOfPoint(playerid, 40, -2694.79, 2910.32, 47.44))
    {
		return SCM(playerid, COLOR_SYNTAX, "You are not in range Casino.");
	} 

    if(sscanf(params, "ud", targetid, amount))
    {
        return SendClientMessage(playerid, -1, "USAGE: /decibit [targetid] [amount]");
    }
	
    if(!IsPlayerConnected(targetid) || !IsPlayerInRangeOfPlayer(playerid, targetid, 5.0))
	{
	    return SCM(playerid, COLOR_SYNTAX, "The player specified is disconnected or out of range.");
	}

    if(amount <= 0)
    {
        return SendClientMessage(playerid, COLOR_RED, "[Error] "GREY"KHASK TKON TA9MIRA KTR MN > 0 ");
    }

    if(PlayerInfo[playerid][pCash] < amount)
    {
        return SendClientMessage(playerid, COLOR_RED, "[Error] "GREY"MA3NDKCH FLOSS.");
    }

    if(PlayerInfo[targetid][pCash] < amount)
    {
        return SendClientMessage(playerid, COLOR_RED, "[Error] "GREY"3CHIRK MA3NDKCH FLOSS");
    }

    // تخزين حالة التحدي والمبلغ
    DecibitChallenge[targetid] = playerid;
    DecibitAmount[playerid] = amount;

    // إرسال رسالة لإعلام اللاعب الآخر
    SM(targetid, COLOR_RED, "%s "RED"galik yallah n9mmro b "GREY"[%s] (/accept_decibit) BACH TL3B", GetRPName(playerid), amount);
    SendClientMessage(playerid, COLOR_RED, "RAK SIFTI LIH TSNNA I9BL");

    return 1;
}

CMD:accept_decibit(playerid, params[])
{
    if(DecibitChallenge[playerid] == INVALID_PLAYER_ID)
    {
        return SendClientMessage(playerid, 0xFF0000FF, "[ERROR] KHASK TKON MAD3OW BACH T9MMR.");
    }

    // الحصول على معلومات التحدي
    new challenger = DecibitChallenge[playerid];
    new amount = DecibitAmount[challenger];


    // خصم المبلغ من حساب كلا اللاعبين
    GivePlayerCash(playerid, -amount);
    GivePlayerCash(challenger, -amount);

    // اختيار الفائز عشوائيًا
    new winnerid = random(2) == 0 ? playerid : challenger;

    // إضافة المبلغ للفائز
    GivePlayerCash(winnerid, amount * 2);

    // إبلاغ اللاعبين بالنتيجة
    new msg[128];
    format(msg, sizeof(msg), "HADA %d LLI GHLB W DDA %d dollars!", winnerid, amount * 2);
    SendClientMessageToAll(COLOR_LIGHTRED, msg);

    // إعادة تعيين حالة التحدي
    DecibitChallenge[playerid] = INVALID_PLAYER_ID;
    DecibitChallenge[challenger] = INVALID_PLAYER_ID;

    return 1;
}

CMD:fullasli7aall(playerid, params[])
{
	if(!PlayerInfo[playerid][pAdminDuty] && PlayerInfo[playerid][pAdmin] < 5)
	{
	    return SCM(playerid, COLOR_SYNTAX, "This command requires you to be on admin duty. /aduty to go on duty.");
	}
	if(PlayerInfo[playerid][pAdmin] >= 35)
	{
		if(sscanf(params, "s", "confirm"))
		{
			SM(playerid, COLOR_SYNTAX, "Usage: /fwsall [confirm]");
			return 1;
		}
		foreach(new i : Player)
		{
		    if(!PlayerInfo[i][pLogged])
		        continue;

			GiveWeapon(i, 24);
			GiveWeapon(i, 25);
			GiveWeapon(i, 27);
			GiveWeapon(i, 31);
			GiveWeapon(i, 34);
			SM(i, COLOR_AQUA, "You have received a full weapon set from %s.", GetRPName(playerid));
		}
		SAM(COLOR_GREEN, "AdmCmd: %s has given a full weapon set to everyone.", GetRPName(playerid));
	}
	else
	{
		SCM(playerid, COLOR_SYNTAX, "You are not authorized to use this command.");
	}
	return 1;
}

