	   SendClientMessage(playerid, COLOR_RED, "[ KPRP ] : Menurunkan Sapi");
    }
    SendClientMessage(playerid, COLOR_RED,"Gunakan Fitur Ini Dimobil Pengirim Sapi");
    }
    return 1;
}
 
 

