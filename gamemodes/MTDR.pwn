		    SCM(playerid, COLOR_YELLOW, "______________________________""RTRP DOUBLE XP SYSTEM("GREEN"Active"YELLOW")_________________________________");
		/*	SCM(playerid, COLOR_WHITE, ""SVRCLR"[SERVER]: "WHITE"Double XP starts at {008000}0:00"WHITE" and ends at {FF0000}3:00"WHITE", SERVER TIME");
