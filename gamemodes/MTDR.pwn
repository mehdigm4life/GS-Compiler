cmd:cstash(playerid, params[])
{
	new action[16], amount; 
	if(PlayerInfo[playerid][pGang] == 0)
	{
	    return SCM(playerid, COLOR_SYNTAX, "You are not apart of a mafia at the moment.");
	}
	if(PlayerInfo[playerid][pGangRank] < 5)
	{
	    return SendClientMessage(playerid, COLOR_GREY, "khask tkon co og ola og bach t7km f casino.");
	}
	if(!IsPlayerInRangeOfPoint(playerid, 5.0, 1357.937866, -1361.118164, 699.791931))
    {
		return SCM(playerid, COLOR_SYNTAX, "You are not in range of your casino stash.");
	}
	if(sscanf(params, "s[16]D(0)", action, amount))
	{
        return SendClientMessage(playerid, -1, "Usage: /cstash [deposit/withdraw/amount] [value]");
	}
    // Show stash
    if(!strcmp(action, "amount", true))
    {
        new msg[64];
        format(msg, sizeof(msg), "Casino Stash Amount: %d$", CasinoStash);
        SendClientMessage(playerid, -1, msg);
        return 1;
    }

    // Deposit
    if(!strcmp(action, "deposit", true))
    {
        if(amount <= 0) return 1;
        if(GetPlayerMoney(playerid) < amount)
            return SendClientMessage(playerid, -1, "Not enough money.");

        GivePlayerCash(playerid, -amount);
        CasinoStash += amount;

        SendClientMessage(playerid, -1, "your Deposited is accepted");
        return 1;
    }

    // Withdraw
    if(!strcmp(action, "withdraw", true))
    {
        if(amount <= 0) return 1;
        if(CasinoStash < amount)
            return SendClientMessage(playerid, -1, "Not enough money in stash.");

        CasinoStash -= amount;
        GivePlayerCash(playerid, amount); 

        SendClientMessage(playerid, -1, "your Withdraw accepted.");
        return 1;
    }

    SendClientMessage(playerid, -1, "Usage: /cstash [deposit/withdraw/amount] [value]");
	return 1;
}

CMD:spin(playerid, params[])
{
    new amount;
	if(!IsPlayerInRangeOfPoint(playerid, 5.0, 1351.94, -1348.52, 699.37))
    {
		return SCM(playerid, COLOR_SYNTAX, "You are not in range of your spin table.");
	}
    if(sscanf(params, "d", amount))
	{
        return SendClientMessage(playerid, -1, "Usage: /spin [amount]");
	}
    if(amount <= 0)
	{
        return SendClientMessage(playerid, -1, "Invalid amount.");
	}
	if(amount > PlayerInfo[playerid][pCash])
	{
        return SendClientMessage(playerid, -1, "Ma7zo9a l9addiya.");
	}
	
	ApplyAnimationEx(playerid, "Freeweights", "gym_free_celebrate", 4.0, 1, 0, 0, 0, 0);
    PlayerPlaySound(playerid, 5201, 0.0, 0.0, 0.0);

    SetTimerEx("FinishSpin", 3000, false, "ii", playerid, amount);
    return 1;
}

forward FinishSpin(playerid, amount);
public FinishSpin(playerid, amount)
{
    ClearAnimations(playerid);
	new casino = random(4);
	
    if(casino == 1)
    {
		GivePlayerCash(playerid, amount);

        SM(playerid, COLOR_GREEN, "[MAFIA CASINO] Rak Rb7ti zahiya floss"GREEN" +%d.", amount);
    }
    else
    {
		CasinoStash += amount; 
		GivePlayerCash(playerid, -amount);
        SM(playerid, COLOR_RED, "[MAFIA CASINO] Rak khsrti mchaw floss"RED" -%d.", amount);
    }

    return 1;
}


