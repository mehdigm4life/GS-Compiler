   if(TakenAyam[playerid] == 1) return SendClientMessage(playerid, COLOR_RED, "[ERROR] Wa Sir Kod Kdma");
   SetPlayerCheckpoint(playerid, 730.225524, -462.672058, 16.335937, 3);
   PutAyam[playerid] += 1;
   TakenAyam[playerid] = 1;
   format(StringAyam, 116, "~g~Total: %i / 5", PutAyam[playerid]), GameTextForPlayer(playerid, StringAyam, 5000, 0);
   ApplyAnimation(playerid,"CARRY","crry_prtial",4.1,1,1,1,1,1,1);
   SetPlayerAttachedObject(playerid, 8, 19137, 1, 0.139, 0.549, 0.000, 5.000, 12.000, 32.000, 1.000, 1.000, 1.000);
   SendClientMessage(playerid, COLOR_YELLOW, "Sir Check point");
   }
