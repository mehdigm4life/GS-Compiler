CMD:sr(playerid, params[]) return callcmd::shadowrims(playerid, params);
CMD:shadowrims(playerid, params[])
{
	new vehicleid = GetPlayerVehicleID(playerid);

	if(!vehicleid || !IsVehicleOwner(playerid, vehicleid))
	{
	    return SCM(playerid, COLOR_SYNTAX, "You are not inside any vehicle of yours.");
	}
	if(!vehicleid || GetPlayerState(playerid) != PLAYER_STATE_DRIVER)
	{
	    return SCM(playerid, COLOR_SYNTAX, "You must be driving a vehicle to use this command.");
	}
	if(PlayerInfo[playerid][pGoldrim] <= 1)
	{
		return SCM(playerid, COLOR_SYNTAX, "You don't have more than 2 goldrims to install.");
	}

	PlayerInfo[playerid][pGoldrim] -= 2;
	mysql_format(connectionID, queryBuffer, sizeof(queryBuffer), "UPDATE users SET goldrim = %i WHERE uid = %i", PlayerInfo[playerid][pGoldrim], PlayerInfo[playerid][pID]);
	mysql_tquery(connectionID, queryBuffer);

    AddVehicleComponent(GetPlayerVehicleID(playerid),1073);
    SendProximityMessage(playerid, 20.0, COLOR_PURPLE, "** %s successfully installed Shadow rims in their vehicle.", GetRPName(playerid));
    return 1;
}

